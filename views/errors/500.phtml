<body>

<header>
    <div class="exception-class"><?= htmlspecialchars(get_class($e)) ?></div>
    <div class="exception-message"><?= htmlspecialchars($e->getMessage()) ?></div>
</header>

<div class="layout">
    <div class="sidebar">
        <?php
        $trace = $e->getTrace();
        // Insert main exception file as the first frame
        array_unshift($trace, [
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'function' => 'Main Exception',
            'class' => get_class($e)
        ]);
        
        foreach ($trace as $index => $frame):
            $file = $frame['file'] ?? '[internal function]';
            $line = $frame['line'] ?? '';
            $shortFile = str_replace(dirname(__DIR__, 2), '', $file);
            
            $method = '';
            if (isset($frame['class'])) {
                $method .= $frame['class'] . ($frame['type'] ?? '::');
            }
            $method .= $frame['function'] ?? '';
        ?>
        <div class="frame <?= $index === 0 ? 'active' : '' ?>" onclick="showFrame(<?= $index ?>)">
            <div class="frame-file"><?= htmlspecialchars($shortFile) ?><?= $line ? ':' . $line : '' ?></div>
            <div class="frame-method"><?= htmlspecialchars($method) ?></div>
        </div>
        <?php endforeach; ?>
    </div>

    <div class="main-content">
        <?php
        foreach ($trace as $index => $frame):
            if (!isset($frame['file']) || !file_exists($frame['file'])) continue;
            
            $file = $frame['file'];
            $targetLine = $frame['line'] ?? 0;
            
            // Read some lines around the error
            $lines = [];
            if ($targetLine > 0 && is_readable($file)) {
                $fileContent = file($file);
                $start = max(0, $targetLine - 10);
                $end = min(count($fileContent), $targetLine + 10);
                
                for ($i = $start; $i < $end; $i++) {
                    $lines[$i + 1] = $fileContent[$i];
                }
            }
        ?>
        <div id="frame-content-<?= $index ?>" class="code-block" style="<?= $index !== 0 ? 'display: none;' : '' ?>">
            <div class="code-header">
                <span><?= htmlspecialchars($file) ?></span>
                <span>Line <?= $targetLine ?></span>
            </div>
            <div class="code-body">
                <?php foreach ($lines as $lineNum => $lineContent): ?>
                <div class="code-line <?= $lineNum === $targetLine ? 'highlight' : '' ?>">
                    <div class="line-number"><?= $lineNum ?></div>
                    <div class="line-content"><?= htmlspecialchars($lineContent) ?></div>
                </div>
                <?php endforeach; ?>
            </div>
        </div>
        <?php endforeach; ?>
    </div>
</div>

<script>
    function showFrame(index) {
        // Update sidebar active state
        document.querySelectorAll('.frame').forEach(el => el.classList.remove('active'));
        const frames = document.querySelectorAll('.frame');
        if (frames[index]) {
            frames[index].classList.add('active');
        }

        // Show/hide main content blocks
        document.querySelectorAll('.code-block').forEach(el => el.style.display = 'none');
        const content = document.getElementById('frame-content-' + index);
        if (content) {
            content.style.display = 'block';
        }
    }
</script>

</body>
</html>
