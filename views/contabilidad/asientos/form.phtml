<!-- Template para nueva fila (Oculto) -->
<template id="filaTemplate">
    <tr class="movimiento-fila">
        <td>
            <select name="cuenta[]" class="form-control form-control-sm select2-cuenta-nueva" required>
                <option value="">Seleccione una cuenta</option>
                <?php foreach ($cuentas as $cta): ?>
                    <option value="<?= htmlspecialchars((string)$cta->id) ?>">
                        <?= htmlspecialchars($cta->codigoCuenta . ' - ' . $cta->denominacion) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </td>
        <td class="text-center">
            <select name="tipo[]" class="form-control form-control-sm tipo-op" required>
                <option value="D">DEBE</option>
                <option value="H">HABER</option>
            </select>
        </td>
        <td>
            <input type="number" step="0.01" min="0.01" name="monto[]" class="form-control form-control-sm text-right input-monto" required>
        </td>
        <td class="text-center align-middle">
            <button type="button" class="btn btn-xs btn-outline-danger btn-eliminar-fila" title="Eliminar Fila">
                <i class="fas fa-trash"></i>
            </button>
        </td>
    </tr>
</template>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Inicializar Select2 si está disponible globalmente en el layout
    if (typeof jQuery !== 'undefined' && typeof jQuery.fn.select2 !== 'undefined') {
        $('.select2-cuenta').select2({ theme: 'bootstrap4', width: '100%' });
    }
    
    const tbody = document.getElementById('tbodyMovimientos');
    const btnAgregar = document.getElementById('btnAgregarFila');
    const template = document.getElementById('filaTemplate');
    const totalDebeEl = document.getElementById('totalDebe');
    const totalHaberEl = document.getElementById('totalHaber');
    const mensajeDescuadre = document.getElementById('mensajeDescuadre');
    const btnGuardar = document.getElementById('btnGuardar');

    function calcularTotales() {
        let totalDebe = 0;
        let totalHaber = 0;

        const filas = document.querySelectorAll('.movimiento-fila');
        filas.forEach(fila => {
            const tipo = fila.querySelector('.tipo-op').value;
            const montoVal = parseFloat(fila.querySelector('.input-monto').value) || 0;
            
            if (tipo === 'D') {
                totalDebe += montoVal;
            } else {
                totalHaber += montoVal;
            }
        });

        totalDebe = Math.round(totalDebe * 100) / 100;
        totalHaber = Math.round(totalHaber * 100) / 100;

        totalDebeEl.textContent = totalDebe.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        totalHaberEl.textContent = totalHaber.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

        const botonesEliminar = document.querySelectorAll('.btn-eliminar-fila');
        if (filas.length <= 2) {
            botonesEliminar.forEach(btn => btn.disabled = true);
        } else {
            botonesEliminar.forEach(btn => btn.disabled = false);
        }

        if (totalDebe > 0 && totalDebe === totalHaber) {
            mensajeDescuadre.style.visibility = 'hidden';
            btnGuardar.disabled = false;
        } else {
            mensajeDescuadre.style.visibility = 'visible';
            btnGuardar.disabled = true;
        }
    }

    btnAgregar.addEventListener('click', function() {
        const clone = template.content.cloneNode(true);
        tbody.appendChild(clone);
        
        if (typeof jQuery !== 'undefined' && typeof jQuery.fn.select2 !== 'undefined') {
            $(tbody).find('.select2-cuenta-nueva').removeClass('select2-cuenta-nueva').select2({ theme: 'bootstrap4', width: '100%' });
        }
        
        calcularTotales();
    });

    tbody.addEventListener('input', function(e) {
        if (e.target.classList.contains('input-monto') || e.target.classList.contains('tipo-op')) {
            calcularTotales();
        }
    });

    if (typeof jQuery !== 'undefined') {
        $(tbody).on('change', '.tipo-op', function() {
            calcularTotales();
        });
    }

    tbody.addEventListener('click', function(e) {
        let btn = e.target.closest('.btn-eliminar-fila');
        if (btn && !btn.disabled) {
            // Si el select2 está presente, hay que destruirlo antes de eliminar el nodo (buenas prácticas)
            if (typeof jQuery !== 'undefined' && typeof jQuery.fn.select2 !== 'undefined') {
                $(btn).closest('tr').find('select').select2('destroy');
            }
            btn.closest('tr').remove();
            calcularTotales();
        }
    });

    calcularTotales();
});
</script>
