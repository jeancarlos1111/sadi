            <td class="align-middle"><small><?= htmlspecialchars($data['unidad_desc']) ?></small></td>
            <td class="align-middle text-muted"><small><?= htmlspecialchars($data['fuente_desc']) ?></small></td>
            <td class="text-right align-middle"><?= number_format($pg->montoAsignado, 2, ',', '.') ?></td>
            <td class="text-right align-middle text-warning"><?= number_format($pg->montoComprometido, 2, ',', '.') ?></td>
            <td class="text-right align-middle text-danger"><?= number_format($pg->montoCausado, 2, ',', '.') ?></td>
            <td class="text-right align-middle font-weight-bold" style="color: <?= htmlspecialchars((string)$colorDisp) ?>;">
              <?= number_format($disponible, 2, ',', '.') ?>
            </td>
            <td class="text-center align-middle text-nowrap">
              <?= render_component('table_actions', [
                'editUrl' => '?route=presupuesto/form&id=' . $pg->id,
                'deleteUrl' => '?route=presupuesto/eliminar',
                'deleteId' => $pg->id
            ]) ?>
            </td>
          </tr>
          <?php endforeach; ?>
        <?php endif; ?>
