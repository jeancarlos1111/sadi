/** @var array|null $ordenSeleccionada */
/** @var array|null $detalles */
/** @var string|null $error */
/** @var string|null $success */
?>
<div class="card card-outline card-primary mb-4">
    <div class="card-header">
        <h3 class="card-title"><?= htmlspecialchars($titulo) ?></h3>
    </div>
    
    <div class="card-body">
        <?php if ($error): ?>
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                <?= htmlspecialchars($error) ?>
            </div>
        <?php endif; ?>
        <?php if ($success): ?>
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                <?= htmlspecialchars($success) ?>
            </div>
        <?php endif; ?>

        <h5 class="text-primary mb-3"><i class="fas fa-search"></i> 1. Seleccionar Orden de Compra Aprobada</h5>
        
        <form method="GET" action="index.php" class="form-inline bg-light p-3 border rounded">
            <input type="hidden" name="route" value="inventario/entradas">
            <div class="input-group w-50">
                <select name="id_orden" class="form-control" required>
                    <option value="">-- Buscar y Seleccionar --</option>
                    <?php foreach ($ordenes as $o): ?>
                        <?php $oc = $o['entity']; ?>
                        <option value="<?= htmlspecialchars((string)$oc->id) ?>" <?= (isset($_GET['id_orden']) && $_GET['id_orden'] == $oc->id) ? 'selected' : '' ?>>
                            Orden #<?= htmlspecialchars((string)$oc->id) ?> | <?= htmlspecialchars($o['proveedor']) ?> | Total: <?= number_format($oc->montoTotal, 2, ',', '.') ?> | Fecha: <?= date('d/m/Y', strtotime($oc->fecha)) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
                <span class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-download"></i> Cargar Detalles</button>
                    <a href="?route=inventario/entradas" class="btn btn-default">Limpiar</a>
                </span>
            </div>
        </form>
    </div>
</div>

<?php if (isset($ordenSeleccionada) && isset($detalles)): ?>
    <div class="card card-outline card-success">
        <div class="card-header">
            <h3 class="card-title text-success"><i class="fas fa-box-open"></i> 2. Procesar Recepción en Almacén</h3>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Proveedor:</strong> <?= htmlspecialchars($ordenSeleccionada['proveedor']) ?>
                </div>
                <div class="col-md-6">
                    <strong>Concepto OC:</strong> <?= htmlspecialchars($ordenSeleccionada['entity']->concepto) ?>
                </div>
            </div>
            
            <?php if (empty($detalles)): ?>
                <div class="alert alert-info">No hay artículos asociados a esta Orden de Compra.</div>
            <?php else: ?>
                <form method="POST" action="?route=inventario/procesarRecepcion" onsubmit="return confirm('¿Está seguro de procesar esta recepción? Esto afectará los saldos de inventario, causará presupuesto y generará compromiso de pago.');">
                    <input type="hidden" name="id_orden" value="<?= $ordenSeleccionada['entity']->id ?>">
                    
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped dataTable w-100 text-center">
                            <thead class="thead-dark">
                                <tr>
                                    <th class="text-left">Artículo</th>
                                    <th>Tipo</th>
                                    <th>Medida</th>
                                    <th>Pedida (OC)</th>
                                    <th>Ya Recibida</th>
                                    <th>Por Recibir</th>
                                    <th>Cantidad a Recibir Ahora</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php 
                                $todoRecibido = true;
                                foreach ($detalles as $d): 
                                    $pedida = (float)$d['cantidad_pedida'];
                                    $recibida = (float)$d['cantidad_recibida'];
                                    $porRecibir = $pedida - $recibida;
                                    
                                    if ($porRecibir > 0) $todoRecibido = false;
                                ?>
                                    <tr class="<?= $porRecibir <= 0 ? 'table-success' : '' ?>">
                                        <td class="text-left">
                                            <?= htmlspecialchars($d['denominacion_a']) ?>
                                            <input type="hidden" name="id_articulo[]" value="<?= htmlspecialchars((string)$d['id_articulo']) ?>">
                                        </td>
                                        <td><?= $d['tipo_tda'] == 1 ? 'Bien Nacional' : 'Insumo/Material' ?></td>
                                        <td><?= htmlspecialchars($d['denominacion_udm']) ?></td>
                                        <td><?= htmlspecialchars((string)$pedida) ?></td>
                                        <td><?= htmlspecialchars((string)$recibida) ?></td>
                                        <td class="font-weight-bold <?= $porRecibir > 0 ? 'text-danger' : 'text-success' ?>">
                                            <?= htmlspecialchars((string)$porRecibir) ?>
                                        </td>
                                        <td>
                                            <?php if ($porRecibir > 0): ?>
                                                <input type="number" class="form-control form-control-sm mx-auto" name="cantidad_recibir[]" max="<?= htmlspecialchars((string)$porRecibir) ?>" min="0" step="1" value="<?= htmlspecialchars((string)$porRecibir) ?>" style="width: 100px;" required>
                                            <?php else: ?>
                                                <span class="badge badge-success px-2 py-1"><i class="fas fa-check"></i> Completo</span>
                                                <input type="hidden" name="cantidad_recibir[]" value="0">
                                            <?php endif; ?>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 text-right">
                        <?php if ($todoRecibido): ?>
                            <div class="alert alert-success d-inline-block text-left mb-0">
                                <strong><i class="fas fa-check-circle"></i> ¡Éxito!</strong> Todos los artículos de esta Orden de Compra ya han sido recibidos en el almacén en su totalidad.
                            </div>
                        <?php else: ?>
                            <button type="submit" class="btn btn-lg btn-success">
                                <i class="fas fa-check"></i> Confirmar Recepción Física
                            </button>
                        <?php endif; ?>
                    </div>
                </form>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>
