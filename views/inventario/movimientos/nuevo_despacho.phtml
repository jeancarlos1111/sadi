<script>
document.addEventListener('DOMContentLoaded', function() {
    // Enable/disable hidden input based on whether quantity > 0
    const inputs = document.querySelectorAll('.cant-input');
    inputs.forEach(input => {
        // Enable them initially so user can type
        input.disabled = false;
        
        input.addEventListener('input', function() {
            const row = this.closest('tr');
            const hiddenId = row.querySelector('input[type="hidden"]');
            const cant = parseFloat(this.value);
            
            if (cant > 0) {
                hiddenId.disabled = false;
            } else {
                hiddenId.disabled = true;
            }
        });
    });
});
</script>
