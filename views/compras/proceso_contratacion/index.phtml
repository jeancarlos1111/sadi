<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchProcessInput');
    const container = document.getElementById('procesosTableContainer');
    
    let debounceTimer;

    const fetchTable = (search, page = 1) => {
        container.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>';
        
        fetch(`?route=proceso_contratacion/index&ajax=1&search=${encodeURIComponent(search)}&page=${page}`)
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                attachPaginationEvents();
            })
            .catch(err => {
                console.error('Error fetching table:', err);
                container.innerHTML = '<div class="alert alert-danger">Error al cargar los datos.</div>';
            });
    };

    const attachPaginationEvents = () => {
        const pageLinks = container.querySelectorAll('.page-link');
        pageLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const url = new URL(link.href, window.location.origin);
                const page = url.searchParams.get('page');
                const search = searchInput.value;
                if (page) {
                    fetchTable(search, page);
                }
            });
        });
    };

    searchInput.addEventListener('keyup', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            fetchTable(e.target.value);
        }, 300);
    });

    attachPaginationEvents();
});
</script>
