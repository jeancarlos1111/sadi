<?php
/**
 * @var string|null $viewUrl   URL para ver detalles
 * @var string|null $editUrl   URL para editar
 * @var string|null $deleteUrl URL para eliminar (Action del form)
 * @var string|int|null $deleteId ID del registro a eliminar
 * @var string|null $deleteIdField Nombre del campo ID (defecto 'id')
 * @var string|null $deleteConfirm Mensaje de confirmación (defecto '¿Está seguro de eliminar este registro?')
 */
$deleteIdField = $deleteIdField ?? 'id';
$deleteConfirm = $deleteConfirm ?? '¿Está seguro de eliminar este registro?';
?>
<div class="btn-group">
    <?php if (!empty($viewUrl)): ?>
        <a href="<?= htmlspecialchars((string)$viewUrl) ?>" class="btn btn-sm btn-info" title="Ver">
            <i class="fas fa-eye"></i>
        </a>
    <?php endif; ?>
    
    <?php if (!empty($editUrl)): ?>
        <a href="<?= htmlspecialchars((string)$editUrl) ?>" class="btn btn-sm btn-warning" title="Editar">
            <i class="fas fa-edit"></i>
        </a>
    <?php endif; ?>
    
    <?php if (!empty($deleteUrl) && isset($deleteId)): ?>
        <form method="POST" action="<?= htmlspecialchars((string)$deleteUrl) ?>" style="display:inline;" onsubmit="return confirm('<?= htmlspecialchars((string)$deleteConfirm) ?>');">
            <input type="hidden" name="<?= htmlspecialchars((string)$deleteIdField) ?>" value="<?= htmlspecialchars((string)$deleteId) ?>">
            <button type="submit" class="btn btn-sm btn-danger" title="Eliminar">
                <i class="fas fa-trash"></i>
            </button>
        </form>
    <?php endif; ?>
</div>
