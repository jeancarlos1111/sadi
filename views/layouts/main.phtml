<script>
$(document).ready(function() {
    let searchTimeout;

    function showLoading() {
        $('.ajax-table-container').css('position', 'relative');
        if ($('.ajax-table-container .ajax-loading-overlay').length === 0) {
            $('.ajax-table-container').append(
                '<div class="ajax-loading-overlay" style="position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(255,255,255,0.6); display:flex; align-items:center; justify-content:center; z-index:10; border-radius:0.25rem;">' +
                '<i class="fas fa-2x fa-spinner fa-spin text-primary"></i>' +
                '</div>'
            );
        }
    }

    // AJAX Search input
    $(document).on('input', '.ajax-search-form input[name="search"]', function(e) {
        clearTimeout(searchTimeout);
        let form = $(this).closest('form');
        
        searchTimeout = setTimeout(function() {
            let url = form.attr('action') || window.location.pathname;
            let data = form.serialize();
            let fullUrl = url + '?' + data;
            
            window.history.pushState({}, '', fullUrl);
            let fetchUrl = fullUrl + '&ajax=1';
            
            showLoading();
            $.get(fetchUrl, function(html) {
                let newTable = $(html).find('.ajax-table-container').html();
                if (!newTable) newTable = html; 
                $('.ajax-table-container').html(newTable);
            }).fail(function() {
                $('.ajax-table-container .ajax-loading-overlay').remove();
            });
        }, 400);
    });

    // AJAX Pagination links
    $(document).on('click', '.ajax-table-container .pagination a', function(e) {
        e.preventDefault();
        let url = $(this).attr('href');
        if (!url || url === '#') return;
        
        window.history.pushState({}, '', url);
        let fetchUrl = url + (url.indexOf('?') === -1 ? '?ajax=1' : '&ajax=1');
        
        showLoading();
        $.get(fetchUrl, function(html) {
            let newTable = $(html).find('.ajax-table-container').html();
            if (!newTable) newTable = html;
            $('.ajax-table-container').html(newTable);
            $('html, body').animate({ scrollTop: $('.ajax-table-container').offset().top - 100 }, 300);
        }).fail(function() {
            $('.ajax-table-container .ajax-loading-overlay').remove();
        });
    });
});
</script>
