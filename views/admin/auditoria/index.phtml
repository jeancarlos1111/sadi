<script>
function showDiff(btn) {
    let antes = btn.getAttribute('data-antes');
    let despues = btn.getAttribute('data-despues');
    
    try { antes = JSON.stringify(JSON.parse(antes), null, 2); } catch(e) {}
    try { despues = JSON.stringify(JSON.parse(despues), null, 2); } catch(e) {}
    
    document.getElementById('preAntes').textContent = antes || 'N/A';
    document.getElementById('preDespues').textContent = despues || 'N/A';
    
    $('#modalDiff').modal('show');
}
</script>
