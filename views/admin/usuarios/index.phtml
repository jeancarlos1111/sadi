<?php
/** @var array $usuarios  Array de ['entity' => Usuario, 'nombre_completo' => string, 'roles' => Rol[]] */
/** @var string $titulo */
/** @var string $search */
/** @var bool $canCreate */
/** @var bool $canEdit */
/** @var bool $canDelete */
?>
<div class="card card-outline card-dark">
  <div class="card-header d-flex align-items-center">
    <h3 class="card-title">
      <i class="fas fa-users-cog mr-2"></i><?= htmlspecialchars($titulo) ?>
    </h3>
    <div class="card-tools ml-auto d-flex gap-2">
      <!-- Búsqueda -->
      <form method="GET" action="" class="d-flex mr-2">
        <input type="hidden" name="route" value="admin/usuarios">
        <input type="text" name="search" value="<?= htmlspecialchars($search) ?>"
               class="form-control form-control-sm" placeholder="Buscar usuario...">
        <button type="submit" class="btn btn-sm btn-secondary ml-1">
          <i class="fas fa-search"></i>
        </button>
      </form>
      <?php if ($canCreate): ?>
      <a href="?route=admin/usuarios_editar" class="btn btn-sm btn-success">
        <i class="fas fa-user-plus"></i> Nuevo Usuario
      </a>
      <?php endif; ?>
    </div>
  </div>
  <div class="card-body p-0">

    <?php if (isset($_GET['saved'])): ?>
    <div class="alert alert-success alert-dismissible m-3">
      <button type="button" class="close" data-dismiss="alert">&times;</button>
      <i class="icon fas fa-check"></i> Usuario guardado correctamente.
    </div>
    <?php endif; ?>

    <table class="table table-bordered table-striped table-hover mb-0">
      <thead class="thead-dark">
        <tr>
          <th width="5%">#</th>
          <th width="25%">Usuario</th>
          <th>Nombre Completo</th>
          <th width="35%">Roles Asignados</th>
          <?php if ($canEdit || $canDelete): ?>
          <th width="12%" class="text-center">Acciones</th>
          <?php endif; ?>
        </tr>
      </thead>
      <tbody>
        <?php if (empty($usuarios)): ?>
        <tr>
          <td colspan="5" class="text-center text-muted py-4">
            <i class="fas fa-user-slash fa-2x d-block mb-2"></i>
            No hay usuarios registrados.
          </td>
        </tr>
        <?php else: foreach ($usuarios as $row):
          /** @var \App\Models\Usuario $u */
          $u = $row['entity']; ?>
        <tr>
          <td class="text-center"><strong><?= htmlspecialchars((string)$u->id) ?></strong></td>
          <td>
            <i class="fas fa-user-circle text-secondary mr-1"></i>
            <strong><?= htmlspecialchars($u->usuario) ?></strong>
          </td>
          <td><?= htmlspecialchars($row['nombre_completo']) ?></td>
          <td>
            <?php if (empty($row['roles'])): ?>
              <span class="badge badge-secondary">Sin roles</span>
            <?php else: foreach ($row['roles'] as $rol): ?>
              <span class="badge badge-dark mr-1"><?= htmlspecialchars($rol->nombre) ?></span>
            <?php endforeach; endif; ?>
          </td>
          <?php if ($canEdit || $canDelete): ?>
          <td class="text-right">
            <?= render_component('table_actions', [
                'editUrl' => $canEdit ? "?route=admin/usuarios_editar&id=" . htmlspecialchars((string)$u->id) : null,
                'deleteUrl' => ($canDelete && $u->id > 1) ? "?route=admin/usuarios_eliminar" : null,
                'deleteId' => $u->id,
                'deleteConfirm' => '¿Eliminar el usuario ' . htmlspecialchars($u->usuario) . '?'
            ]) ?>
          </td>
          <?php endif; ?>
        </tr>
        <?php endforeach; endif; ?>
      </tbody>
    </table>
  </div>
  <div class="card-footer">
    <?php if (isset($paginator)): ?>
      <?php include $partialsPath . 'pagination.phtml'; ?>
    <?php else: ?>
      <span class="text-muted small">Total: <strong><?= count($usuarios) ?></strong> usuario(s).</span>
    <?php endif; ?>
  </div>
</div>
