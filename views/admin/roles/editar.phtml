<script>
function selectAll(checked) {
  document.querySelectorAll('.permiso-check').forEach(c => c.checked = checked);
  actualizarContador();
}

function toggleColumna(accion) {
  const checks = document.querySelectorAll('.permiso-' + accion);
  const allChecked = Array.from(checks).every(c => c.checked);
  checks.forEach(c => c.checked = !allChecked);
  actualizarContador();
}

function toggleModulo(modulo) {
  const checks = document.querySelectorAll('.permiso-modulo-' + modulo);
  const allChecked = Array.from(checks).every(c => c.checked);
  checks.forEach(c => c.checked = !allChecked);
  actualizarContador();
}

function actualizarContador() {
  const total = document.querySelectorAll('.permiso-check').length;
  const sel   = document.querySelectorAll('.permiso-check:checked').length;
  document.getElementById('contadorPermisos').textContent = sel + ' / ' + total + ' permisos seleccionados';
}

document.querySelectorAll('.permiso-check').forEach(c => c.addEventListener('change', actualizarContador));
actualizarContador();
</script>
