<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.mov-checkbox');
    const checkAll = document.getElementById('check-all');
    const saldoBancoInput = document.getElementById('saldo_estado_cuenta');
    const displayTransito = document.getElementById('display-transito');
    const alertCuadre = document.getElementById('cuadre-alert');
    const btnGuardar = document.getElementById('btn-guardar');
    
    // PHP variables
    const saldoLibros = <?= isset($saldoLibros) ? json_encode($saldoLibros) : '0' ?>;
    
    function parseMonto(val) {
        if (!val) return 0;
        let str = val.replace(/\./g, '').replace(/,/g, '.');
        let floatVal = parseFloat(str);
        return isNaN(floatVal) ? 0 : floatVal;
    }
    
    function formatMonto(val) {
        return new Intl.NumberFormat('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val);
    }

    function recalcular() {
        if (!saldoBancoInput) return;
        
        let sumaTransito = 0;
        
        checkboxes.forEach(chk => {
            if (!chk.checked) {
                sumaTransito += parseFloat(chk.getAttribute('data-monto'));
            }
        });
        
        displayTransito.textContent = 'Bs. ' + formatMonto(sumaTransito);
        
        let saldoBanco = parseMonto(saldoBancoInput.value);
        let saldoCalculado = saldoBanco + sumaTransito;
        let diferencia = Math.abs(saldoLibros - saldoCalculado);
        
        if (saldoBancoInput.value.trim() === '') {
            alertCuadre.className = 'alert mt-3 mb-0 text-center alert-secondary';
            alertCuadre.textContent = 'Ingrese el saldo según banco para verificar cuadre.';
            btnGuardar.disabled = true;
        } else if (diferencia <= 0.01) {
            alertCuadre.className = 'alert mt-3 mb-0 text-center alert-success fw-bold';
            alertCuadre.textContent = '¡CUADRE EXACTO! Saldo Banco + Tránsito coincide con Libros.';
            btnGuardar.disabled = false;
        } else {
            alertCuadre.className = 'alert mt-3 mb-0 text-center alert-danger fw-bold';
            alertCuadre.textContent = 'DIFERENCIA DETECTADA: Bs. ' + formatMonto(diferencia) + ' (Revise estado de cuenta o movimientos marcados)';
            btnGuardar.disabled = true;
        }
    }

    if (checkAll) {
        checkAll.addEventListener('change', function() {
            checkboxes.forEach(chk => chk.checked = this.checked);
            recalcular();
        });
    }

    checkboxes.forEach(chk => {
        chk.addEventListener('change', recalcular);
    });

    if (saldoBancoInput) {
        saldoBancoInput.addEventListener('input', recalcular);
    }

    // Calcular al inicio
    recalcular();
});
</script>
