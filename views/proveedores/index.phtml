<div class="card card-outline card-primary">
  <div class="card-header">
    <h3 class="card-title"><?= htmlspecialchars($titulo) ?></h3>
    <div class="card-tools">
      <a href="?route=proveedores/form" class="btn btn-sm btn-success">
        <i class="fas fa-plus"></i> Nuevo Proveedor
      </a>
    </div>
  </div>
  <div class="card-body">
    <?php if (isset($error)): ?>
      <?= render_component('alert', ['type' => 'danger', 'message' => $error]) ?>
    <?php endif; ?>

    <div class="mb-3">
      <?= render_component('search_filter', [
          'route' => 'proveedores/index',
          'searchValue' => $search ?? ''
      ]) ?>
    </div>

    <div class="ajax-table-container">
      <table class="table table-bordered table-striped w-100">
      <thead>
        <tr>
          <th>RIF</th>
          <th>NIT</th>
          <th>Compañía</th>
          <th>RNC</th>
          <th>Tipo Organización</th>
          <th>Dirección</th>
          <th>Teléfono</th>
          <th width="15%">Acciones</th>
        </tr>
      </thead>
      <tbody>
      <?php if (!empty($proveedores)): ?>
        <?php foreach ($proveedores as $data): ?>
          <?php 
            $p = $data['entity']; 
            $tipoOrg = $data['nombre_tipo_organizacion'];
          ?>
          <tr>
            <?php 
              $isExpired = false;
              if ($p->numeroRnc && $p->fechaVencimientoRnc) {
                  $isExpired = strtotime($p->fechaVencimientoRnc) < strtotime(date('Y-m-d'));
              }
            ?>
            <td><?= htmlspecialchars($p->rif) ?></td>
            <td><?= htmlspecialchars($p->nit ?? '') ?></td>
            <td><?= htmlspecialchars($p->compania) ?></td>
            <td>
              <?php if ($p->numeroRnc): ?>
                <?= htmlspecialchars($p->numeroRnc) ?>
                <?php if ($isExpired): ?>
                  <span class="badge badge-danger">Vencido</span>
                <?php endif; ?>
              <?php else: ?>
                <span class="text-muted">N/A</span>
              <?php endif; ?>
            </td>
            <td><?= htmlspecialchars($tipoOrg ?? 'N/A') ?></td>
            <td><?= htmlspecialchars($p->direccion ?? '') ?></td>
            <td><?= htmlspecialchars($p->telefono ?? '') ?></td>
            <td class="text-center">
              <?= render_component('table_actions', [
                'editUrl' => '?route=proveedores/form&id=' . $p->id,
                'deleteUrl' => '?route=proveedores/eliminar',
                'deleteId' => $p->id
            ]) ?>
            </td>
          </tr>
        <?php endforeach; ?>
      <?php endif; ?>
  </tbody>
</table>
    <?php if (isset($paginator)): ?>
      <?= render_component('pagination', [
          'page' => $paginator['current_page'],
          'totalPages' => $paginator['last_page']
      ]) ?>
    <?php endif; ?>
    </div>
  </div>
</div>
