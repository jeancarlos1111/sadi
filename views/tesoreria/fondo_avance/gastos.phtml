<?php
/** @var string $titulo */
/** @var \App\Models\FondoAvanceReposicion $reposicion */
/** @var \App\Models\FondoAvance $fondo */
/** @var array $gastos */
/** @var string|null $error */
/** @var string|null $success */

$esPendiente = $reposicion->estado === 'PENDIENTE';
$total = array_reduce($gastos, fn($c, $i) => $c + $i['monto'], 0);
?>
<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title"><?= htmlspecialchars($titulo) ?></h3>
        <div class="card-tools">
            <span class="badge <?= $esPendiente ? 'badge-warning' : 'badge-success' ?> p-2">
                ESTADO: <?= $reposicion->estado ?>
            </span>
        </div>
    </div>
    
    <div class="card-body">
        <?php if ($error): ?>
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                <?= htmlspecialchars($error) ?>
            </div>
        <?php endif; ?>
        <?php if ($success): ?>
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                <?= htmlspecialchars($success) ?>
            </div>
        <?php endif; ?>

        <?php if ($esPendiente): ?>
            <form method="POST" action="?route=fondo_avance/guardarGasto" class="mb-4 bg-light p-3 border rounded">
                <input type="hidden" name="id_reposicion" value="<?= $reposicion->idReposicion ?>">
                <h5>Registrar Nuevo Gasto (Comprobante)</h5>
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Fecha</label>
                            <input type="date" class="form-control form-control-sm" name="fecha_gasto" value="<?= date('Y-m-d') ?>" required>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Concepto</label>
                            <input type="text" class="form-control form-control-sm" name="concepto" required>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>RIF Proveedor</label>
                            <input type="text" class="form-control form-control-sm" name="proveedor_rif">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>N° Factura</label>
                            <input type="text" class="form-control form-control-sm" name="factura_num">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Monto (Bs)</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" name="monto" required>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Agregar Gasto</button>
            </form>
        <?php endif; ?>

        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm w-100">
                <thead class="thead-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Concepto</th>
                        <th>RIF Prov.</th>
                        <th>Factura</th>
                        <th class="text-right">Monto (Bs)</th>
                        <?php if ($esPendiente): ?>
                            <th class="text-center">Quitar</th>
                        <?php endif; ?>
                    </tr>
                </thead>
                <tbody>
                    <?php if (empty($gastos)): ?>
                        <tr><td colspan="<?= $esPendiente ? '6' : '5' ?>" class="text-center">No se han registrado gastos para esta rendición.</td></tr>
                    <?php else: ?>
                        <?php foreach ($gastos as $g): ?>
                            <tr>
                                <td><?= date('d/m/Y', strtotime($g['fecha_gasto'])) ?></td>
                                <td><?= htmlspecialchars($g['concepto']) ?></td>
                                <td><?= htmlspecialchars($g['proveedor_rif'] ?? '') ?></td>
                                <td><?= htmlspecialchars($g['factura_num'] ?? '') ?></td>
                                <td class="text-right"><?= number_format((float)$g['monto'], 2, ',', '.') ?></td>
                                <?php if ($esPendiente): ?>
                                    <td class="text-center">
                                        <form method="POST" action="?route=fondo_avance/eliminarGasto" style="display:inline;">
                                            <input type="hidden" name="id_gasto" value="<?= $g['id_gasto'] ?>">
                                            <input type="hidden" name="id_reposicion" value="<?= $reposicion->idReposicion ?>">
                                            <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('¿Seguro?');"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </td>
                                <?php endif; ?>
                            </tr>
                        <?php endforeach; ?>
                        <tr class="font-weight-bold bg-light">
                            <td colspan="4" class="text-right">TOTAL RENDIDO:</td>
                            <td class="text-right text-success"><?= number_format($total, 2, ',', '.') ?></td>
                            <?php if ($esPendiente): ?><td></td><?php endif; ?>
                        </tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
        
        <?php if ($esPendiente && $total > 0): ?>
            <form method="POST" action="?route=fondo_avance/enviarReposicion" class="mt-3">
                <input type="hidden" name="id_reposicion" value="<?= $reposicion->idReposicion ?>">
                <button type="submit" class="btn btn-warning" onclick="return confirm('¿Está seguro de enviar esta rendición para su aprobación y posterior reposición?');">
                    <i class="fas fa-paper-plane"></i> Enviar Rendición (Aprobar)
                </button>
            </form>
        <?php endif; ?>
    </div>
    
    <div class="card-footer">
        <a href="?route=fondo_avance/reposiciones&id_fondo=<?= $reposicion->idFondo ?>" class="btn btn-default"><i class="fas fa-arrow-left"></i> Volver a Rendiciones</a>
    </div>
</div>
