        <div class="table-responsive">
            <table class="table table-bordered table-striped dataTable w-100">
                <thead class="thead-dark">
                    <tr>
                        <th>N° Rendición</th>
                        <th>Fecha Inicio</th>
                        <th>Monto Rendido (Bs)</th>
                        <th>Estado</th>
                        <th>Solicitud Pago Asoc.</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <?php if (empty($reposiciones)): ?>
                        <tr><td colspan="6" class="text-center">No se encontraron rendiciones para este fondo.</td></tr>
                    <?php else: ?>
                        <?php foreach ($reposiciones as $rep): ?>
                            <tr>
                                <td>R-<?= str_pad((string)$rep['id_reposicion'], 4, '0', STR_PAD_LEFT) ?></td>
                                <td><?= date('d/m/Y', strtotime($rep['fecha_reposicion'])) ?></td>
                                <td class="text-right font-weight-bold"><?= number_format((float)$rep['monto_rendido'], 2, ',', '.') ?></td>
                                <td>
                                    <?php
                                        $badge = 'secondary';
                                        if ($rep['estado'] === 'PENDIENTE') $badge = 'warning';
                                        if ($rep['estado'] === 'APROBADA') $badge = 'info';
                                        if ($rep['estado'] === 'PAGADA') $badge = 'success';
                                    ?>
                                    <span class="badge badge-<?= $badge ?>"><?= $rep['estado'] ?></span>
                                </td>
                                <td>
                                    <?= $rep['numero_solicitud'] ? htmlspecialchars($rep['numero_solicitud']) : '<span class="text-muted">Ninguna</span>' ?>
