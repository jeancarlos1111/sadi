                                <td class="text-center">
                                    <a href="?route=fondo_avance/gastos&id_reposicion=<?= $rep['id_reposicion'] ?>" class="btn btn-sm btn-info" title="Ver / Cargar Gastos">
                                        <i class="fas fa-list"></i> Ver Gastos
                                    </a>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
