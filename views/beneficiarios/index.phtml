      <?= render_component('search_filter', [
          'route' => 'beneficiarios/index',
          'searchValue' => $search ?? ''
      ]) ?>
    </div>

    <div class="ajax-table-container">
      <table class="table table-bordered table-striped w-100">
      <thead>
        <tr>
          <th>Cédula</th>
