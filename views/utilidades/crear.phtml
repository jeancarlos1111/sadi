                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
function simularCalculo() {
    const anio = document.getElementById('anio').value;
    const diasBase = document.getElementById('dias_base').value;
    const container = document.getElementById('simulacion_container');
    const footerConfirmar = document.getElementById('footer_confirmar');

    container.style.display = 'block';
    container.innerHTML = '<div class="text-center w-100 py-5"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><p class="mt-2">Procesando nómina masiva de utilidades...</p></div>';
    footerConfirmar.style.display = 'none';

    fetch('?route=utilidad/simular&ajax=1', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: `anio=${anio}&dias_base=${diasBase}`
    })
    .then(response => response.text())
    .then(html => {
        container.innerHTML = html;
        container.style.display = 'block';
        if (html.includes('confirmar_calculo')) {
            footerConfirmar.style.display = 'block';
        }
    })
    .catch(error => {
        container.innerHTML = `<div class="alert alert-danger">Error al calcular: ${error}</div>`;
    });
}
</script>
